:root {
  --canvas: #07070a;
  --canvas-deep: #030305;
  --surface: #101016;
  --surface-elevated: #17151f;
  --line: #2b2935;
  --line-soft: rgba(255, 255, 255, 0.09);
  --text: #f5f3fa;
  --muted: #aaa5b7;
  --dim: #777281;
  --accent: #39d5ff;
  --accent-soft: #7de8ff;
  --accent-deep: #0a3d4a;
  --signal: #39d5ff;
  --shell: min(1240px, calc(100vw - 64px));
  --ease: cubic-bezier(.2, .8, .2, 1);
  --display: "Sora", "Inter", sans-serif;
  --ui: "Inter", system-ui, sans-serif;
  --mono: "JetBrains Mono", monospace;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; background: var(--canvas); }
body { min-width: 320px; margin: 0; overflow-x: hidden; background: radial-gradient(circle at 80% 4%, rgba(101, 54, 145, .12), transparent 25rem), var(--canvas); color: var(--text); font-family: var(--ui); -webkit-font-smoothing: antialiased; }
body.dialog-open { overflow: hidden; }
button, a { color: inherit; }
a { text-decoration: none; }
button { font: inherit; }
img, svg, canvas { display: block; max-width: 100%; }
::selection { background: rgba(57, 213, 255, .35); color: #fff; }
.shell { width: var(--shell); margin-inline: auto; }

